# Public HTTPS URL of the ServeHome API (no trailing slash). Required for production builds.
EXPO_PUBLIC_API_URL=https://api.your-domain.com
# Stripe publishable key (pk_live_... / pk_test_...). Leave empty to hide card payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Google Maps SDK for Android key (request map pin + live tracking). iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_API_KEY=
# EAS project id for push notifications (shown by `eas init` / expo.dev). Not needed for Expo Go or web.
EAS_PROJECT_ID=
