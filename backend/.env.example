# ─── SERVER ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public HTTPS URL of this API (used to build links to uploaded files)
API_HOST=https://api.your-domain.com
# Comma-separated browser origins allowed by CORS (the web build of the app). Native apps are always allowed.
CORS_ORIGINS=https://app.your-domain.com
# Number of reverse proxies in front of the server (for correct client IPs in rate limiting)
TRUST_PROXY=1

# ─── SUPABASE ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── AUTH ────────────────────────────────────────────────────────────────────
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ─── EMAIL (password reset codes) ────────────────────────────────────────────
# Either a generic SMTP provider...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ServeHome <no-reply@your-domain.com>"
# ...or Gmail with an App Password
GMAIL_USER=
GMAIL_PASS=

# ─── STRIPE (card payments) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://api.your-domain.com/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=sar

# ─── ADMIN SEED (npm run seed) ───────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
ADMIN_PHONE=
